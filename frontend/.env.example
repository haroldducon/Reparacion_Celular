# URL pública del backend, terminando en /api. En Vercel se configura en Settings > Environment Variables.
# Local:
VITE_API_URL="http://localhost:3000/api"
# Producción (ejemplo):
# VITE_API_URL="https://taller-api.onrender.com/api"
#
# IMPORTANTE: todo lo que empiece por VITE_ queda visible para cualquiera en el navegador. Nunca pongas secretos aquí.
