# ===== COPIA ESTE ARCHIVO A ".env" Y COMPLETA LOS VALORES. NUNCA SUBAS ".env" A GIT =====

# Neon: usa la cadena de conexión con sslmode=require.
# Para evitar problemas con el pooler (PgBouncer) y las migraciones, usa la conexión DIRECTA (sin "-pooler").
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require&connection_limit=5"

# Redis (Upstash u otro). Con TLS empieza por rediss://
REDIS_URL="rediss://default:clave@host:6379"

# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Deben ser DISTINTOS entre sí y de al menos 32 caracteres.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# URL exacta de tu frontend (sin "/" final). Varias separadas por coma. Ej: https://mi-taller.vercel.app
CORS_ORIGINS="http://localhost:5173"

# URL del frontend para los enlaces de seguimiento en los correos (si no la pones, se usa la primera de CORS_ORIGINS)
# FRONTEND_URL="https://mi-taller.vercel.app"

# ===== Correos con Resend (https://resend.com) =====
# Para escribirle a CLIENTES necesitas verificar un dominio tuyo en Resend. Sin dominio solo envía a tu propio correo.
RESEND_API_KEY=""
EMAIL_FROM="Tech Tinker <notificaciones@tudominio.com>"
# EMAIL_REPLY_TO="tu-correo@gmail.com"

# ===== Informe con IA: Google Gemini (clave gratuita en https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"

# ===== Fotos en Cloudinary (https://cloudinary.com, plan gratuito) =====
# Sin estas 3 variables las fotos se guardan en disco local (solo sirve para desarrollo).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Opcional
PORT=3000
# Carpeta de fotos en disco local (solo si NO usas Cloudinary)
# UPLOAD_DIR=
# Zona horaria del negocio para reportes por día (Colombia: -05:00)
# APP_TIMEZONE=America/Bogota
# APP_TZ_OFFSET=-05:00
